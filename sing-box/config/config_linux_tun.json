{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-server-hosts",
                "type": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ],
                    "cloudflare-dns.com": [
                        "1.1.1.1",
                        "1.0.0.1"
                    ],
                    "dns.alidns.com": [
                        "223.5.5.5",
                        "223.6.6.6"
                    ],
                    "doh.pub": [
                        "120.53.53.53",
                        "1.12.12.12"
                    ]
                }
            },
            {
                "tag": "dns-server-proxy",
                "type": "https",
                "server": "cloudflare-dns.com",
                "domain_resolver": "dns-server-hosts",
                "detour": "DNS"
            },
            {
                "tag": "dns-server-direct",
                "type": "h3",
                "server": "dns.alidns.com",
                "domain_resolver": "dns-server-hosts"
            },
            {
                "tag": "dns-server-bootstrap",
                "type": "https",
                "server": "doh.pub",
                "domain_resolver": "dns-server-hosts"
            }
        ],
        "rules": [
            {
                "query_type": [
                    "SVCB",
                    "HTTPS",
                    "PTR"
                ],
                "action": "reject"
            },
            {
                "clash_mode": "Direct",
                "server": "dns-server-direct"
            },
            {
                "clash_mode": "Global",
                "server": "dns-server-proxy"
            },
            {
                "rule_set": "site-ads",
                "action": "reject"
            },
            {
                "rule_set": [
                    "site-emby-self",
                    "site-proxy-self"
                ],
                "server": "dns-server-proxy"
            },
            {
                "rule_set": "site-direct-self",
                "server": "dns-server-direct"
            },
            {
                "rule_set": [
                    "site-ai",
                    "site-youtube",
                    "site-google",
                    "site-github",
                    "site-telegram",
                    "site-x",
                    "site-facebook",
                    "site-twitch",
                    "site-tiktok",
                    "site-netflix"
                ],
                "server": "dns-server-proxy"
            },
            {
                "rule_set": [
                    "site-bilibili",
                    "site-apple",
                    "site-microsoft"
                ],
                "server": "dns-server-direct"
            },
            {
                "rule_set": "site-proxy",
                "server": "dns-server-proxy"
            },
            {
                "rule_set": "site-direct",
                "server": "dns-server-direct"
            }
        ],
        "final": "dns-server-proxy",
        "cache_capacity": 4096,
        "optimistic": {
            "enabled": true,
            "timeout": "12h"
        }
    },
    "ntp": {
        "enabled": false,
        "server": "time.apple.com",
        "server_port": 123,
        "interval": "30m",
        "domain_resolver": "dns-server-bootstrap"
    },
    "certificate": {},
    "certificate_providers": [],
    "http_clients": [
        {
            "tag": "http-client-proxy",
            "detour": "AUTO"
        }
    ],
    "endpoints": [],
    "inbounds": [
        {
            "tag": "dns-in",
            "type": "direct",
            "listen": "::",
            "listen_port": 1053
        },
        {
            "tag": "http-in",
            "type": "http",
            "listen": "::",
            "listen_port": 8080
        },
        {
            "tag": "socks-in",
            "type": "socks",
            "listen": "::",
            "listen_port": 1080
        },
        {
            "tag": "redirect-in",
            "type": "redirect",
            "listen": "::",
            "listen_port": 7890
        },
        {
            "tag": "tproxy-in",
            "type": "tproxy",
            "listen": "::",
            "listen_port": 7891
        },
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "dns_mode": "hijack",
            "stack": "mixed",
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "tag": "PROXY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "RELAY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "EMBY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "FINAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "GLOBAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "DNS",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-HK",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-TW",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-JP",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-SG",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-US",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-RD",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "A-HK",
            "type": "urltest",
            "outbounds": [
                "S-HK"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "A-TW",
            "type": "urltest",
            "outbounds": [
                "S-TW"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "A-JP",
            "type": "urltest",
            "outbounds": [
                "S-JP"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "A-SG",
            "type": "urltest",
            "outbounds": [
                "S-SG"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "A-US",
            "type": "urltest",
            "outbounds": [
                "S-US"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "A-RD",
            "type": "urltest",
            "outbounds": [
                "S-RD"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "AUTO",
            "type": "urltest",
            "outbounds": [],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "TESTING",
            "type": "urltest",
            "outbounds": [
                "DIRECT"
            ],
            "url": "https://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 100
        },
        {
            "tag": "DIRECT",
            "type": "direct"
        }
    ],
    "route": {
        "rules": [
            {
                "inbound": [
                    "tun-in",
                    "http-in",
                    "socks-in",
                    "redirect-in",
                    "tproxy-in"
                ],
                "action": "sniff"
            },
            {
                "inbound": "dns-in",
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "DIRECT"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "network": "udp",
                        "port": 443
                    },
                    {
                        "protocol": "stun"
                    }
                ],
                "action": "reject"
            },
            {
                "clash_mode": "Direct",
                "outbound": "DIRECT"
            },
            {
                "clash_mode": "Global",
                "outbound": "GLOBAL"
            },
            {
                "rule_set": "site-ads",
                "action": "reject"
            },
            {
                "rule_set": "site-proxy-self",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-emby-self",
                "outbound": "EMBY"
            },
            {
                "rule_set": "site-direct-self",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-ai",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-youtube",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-google",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-github",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "site-telegram",
                    "ip-telegram"
                ],
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-x",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-facebook",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-twitch",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-tiktok",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "site-netflix",
                    "ip-netflix"
                ],
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-bilibili",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-apple",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-microsoft",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-proxy",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "site-direct",
                    "ip-cn"
                ],
                "outbound": "DIRECT"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "site-ads",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblocksingbox.srs"
            },
            {
                "tag": "site-emby-self",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/emby.json"
            },
            {
                "tag": "site-proxy-self",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/proxy.json"
            },
            {
                "tag": "site-direct-self",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/direct.json"
            },
            {
                "tag": "site-ai",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-category-ai-!cn.srs"
            },
            {
                "tag": "site-youtube",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-youtube.srs"
            },
            {
                "tag": "site-google",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-google.srs"
            },
            {
                "tag": "site-github",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-github.srs"
            },
            {
                "tag": "site-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-telegram.srs"
            },
            {
                "tag": "site-x",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-x.srs"
            },
            {
                "tag": "site-facebook",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-facebook.srs"
            },
            {
                "tag": "site-bilibili",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-bilibili.srs"
            },
            {
                "tag": "site-twitch",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-twitch.srs"
            },
            {
                "tag": "site-tiktok",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-tiktok.srs"
            },
            {
                "tag": "site-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-netflix.srs"
            },
            {
                "tag": "site-apple",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-apple.srs"
            },
            {
                "tag": "site-microsoft",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-microsoft.srs"
            },
            {
                "tag": "site-proxy",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs"
            },
            {
                "tag": "site-direct",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cn.srs"
            },
            {
                "tag": "ip-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/telegramip.srs"
            },
            {
                "tag": "ip-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/netflixip.srs"
            },
            {
                "tag": "ip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cnip.srs"
            }
        ],
        "final": "FINAL",
        "auto_detect_interface": true,
        "default_domain_resolver": "dns-server-bootstrap",
        "default_http_client": "http-client-proxy"
    },
    "services": [
        {
            "type": "api",
            "listen": "0.0.0.0",
            "listen_port": 9091,
            "secret": "",
            "access_control_allow_origin": [],
            "access_control_allow_private_network": true,
            "dashboard": {
                "enabled": true,
                "path": "/etc/sing-box/dashboard",
                "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "http-client-proxy"
            }
        }
    ],
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "default_mode": "Rule"
        },
        "cache_file": {
            "enabled": true,
            "path": "/etc/sing-box/cache.db",
            "store_dns": true
        }
    }
}