{
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090"
        },
        "cache_file": {
            "enabled": true,
            "store_dns": true
        }
    },
    "services": [
        {
            "type": "api",
            "listen": "0.0.0.0",
            "listen_port": 9091,
            "secret": "",
            "access_control_allow_origin": [],
            "access_control_allow_private_network": true,
            "dashboard": {
                "enabled": true,
                "path": "/etc/sing-box/dashboard",
                "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "hc_proxy"
            }
        }
    ],
    "log": {
        "level": "info",
        "timestamp": true
    },
    "ntp": {
        "enabled": true,
        "server": "ntp.tencent.com",
        "server_port": 123,
        "interval": "30m",
        "domain_resolver": "dns_direct"
    },
    "http_clients": [
        {
            "tag": "hc_direct",
            "detour": "DIRECT"
        },
        {
            "tag": "hc_proxy",
            "detour": "AUTO"
        }
    ],
    "dns": {
        "servers": [
            {
                "tag": "dns_proxy",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": {
                    "server": "hosts"
                },
                "detour": "DNS"
            },
            {
                "tag": "dns_direct",
                "type": "https",
                "server": "dns.alidns.com",
                "domain_resolver": {
                    "server": "hosts"
                }
            },
            {
                "type": "hosts",
                "tag": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ],
                    "dns.alidns.com": [
                        "223.5.5.5",
                        "223.6.6.6"
                    ]
                }
            }
        ],
        "rules": [
            {
                "clash_mode": "Direct",
                "server": "dns_direct"
            },
            {
                "clash_mode": "Global",
                "server": "dns_proxy"
            },
            {
                "rule_set": "site-ads",
                "action": "predefined",
                "rcode": "NXDOMAIN"
            },
            {
                "rule_set": [
                    "site-ai",
                    "site-youtube",
                    "site-google",
                    "site-github",
                    "site-telegram",
                    "site-x",
                    "site-facebook",
                    "site-twitch",
                    "site-tiktok",
                    "site-netflix"
                ],
                "server": "dns_proxy"
            },
            {
                "rule_set": [
                    "site-bilibili",
                    "site-apple",
                    "site-microsoft"
                ],
                "server": "dns_direct"
            },
            {
                "rule_set": [
                    "site-emby",
                    "site-proxy",
                    "site-proxy-dustinwin"
                ],
                "server": "dns_proxy"
            },
            {
                "rule_set": [
                    "site-direct",
                    "site-direct-dustinwin"
                ],
                "server": "dns_direct"
            }
        ],
        "final": "dns_proxy",
        "strategy": "ipv4_only",
        "cache_capacity": 4096
    },
    "inbounds": [
        {
            "tag": "dns-in",
            "type": "direct",
            "listen": "::",
            "listen_port": 1053
        },
        {
            "tag": "http-in",
            "type": "http",
            "listen": "::",
            "listen_port": 8080
        },
        {
            "tag": "socks-in",
            "type": "socks",
            "listen": "::",
            "listen_port": 1080
        },
        {
            "tag": "redirect-in",
            "type": "redirect",
            "listen": "::",
            "listen_port": 7890
        },
        {
            "tag": "tproxy-in",
            "type": "tproxy",
            "listen": "::",
            "listen_port": 7891
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.19.0.1/30"
            ],
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true,
            "dns_mode": "hijack",
            "stack": "mixed",
            "endpoint_independent_nat": true,
            "udp_timeout": "5m"
        }
    ],
    "outbounds": [
        {
            "tag": "PROXY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "AUTO",
            "type": "urltest",
            "outbounds": [],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "FINAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "GLOBAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "RELAY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "DNS",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "EMBY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "STREAMING",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "SOCIAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "AUTO-TEST",
            "type": "urltest",
            "outbounds": [
                "DIRECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "HK-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "TW-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "JP-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "SG-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "US-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "RD-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "HK-AUTO",
            "type": "urltest",
            "outbounds": [
                "HK-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "TW-AUTO",
            "type": "urltest",
            "outbounds": [
                "TW-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "JP-AUTO",
            "type": "urltest",
            "outbounds": [
                "JP-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "SG-AUTO",
            "type": "urltest",
            "outbounds": [
                "SG-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "US-AUTO",
            "type": "urltest",
            "outbounds": [
                "US-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "RD-AUTO",
            "type": "urltest",
            "outbounds": [
                "RD-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "180s",
            "tolerance": 150,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "DIRECT",
            "type": "direct"
        }
    ],
    "route": {
        "final": "PROXY",
        "auto_detect_interface": true,
        "default_domain_resolver": "dns_direct",
        "default_http_client": "hc_proxy",
        "rules": [
            {
                "inbound": [
                    "http-in",
                    "socks-in",
                    "redirect-in",
                    "tproxy-in",
                    "tun-in"
                ],
                "action": "sniff",
                "timeout": "1s"
            },
            {
                "inbound": "dns-in",
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "DIRECT"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "network": "udp",
                        "port": 443
                    },
                    {
                        "protocol": "stun"
                    }
                ],
                "action": "reject"
            },
            {
                "clash_mode": "Direct",
                "outbound": "DIRECT"
            },
            {
                "clash_mode": "Global",
                "outbound": "GLOBAL"
            },
            {
                "rule_set": "site-ads",
                "action": "reject"
            },
            {
                "rule_set": "site-proxy",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-emby",
                "outbound": "EMBY"
            },
            {
                "rule_set": "site-direct",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-ai",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-youtube",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "site-google",
                "outbound": "PROXY"
            },
            {
                "rule_set": "site-github",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "site-telegram",
                    "ip-telegram-dustinwin"
                ],
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "site-x",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "site-facebook",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "site-twitch",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "site-tiktok",
                "outbound": "STREAMING"
            },
            {
                "rule_set": [
                    "site-netflix",
                    "ip-netflix-dustinwin"
                ],
                "outbound": "STREAMING"
            },
            {
                "rule_set": "site-bilibili",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-apple",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-microsoft",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "site-proxy-dustinwin",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "site-direct-dustinwin",
                    "ip-cn-dustinwin"
                ],
                "outbound": "DIRECT"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "site-ads",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblocksingbox.srs"
            },
            {
                "tag": "site-emby",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/emby.json"
            },
            {
                "tag": "site-proxy",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/proxy.json"
            },
            {
                "tag": "site-direct",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/direct.json"
            },
            {
                "tag": "site-ai",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-category-ai-!cn.srs"
            },
            {
                "tag": "site-youtube",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-youtube.srs"
            },
            {
                "tag": "site-google",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-google.srs"
            },
            {
                "tag": "site-github",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-github.srs"
            },
            {
                "tag": "site-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-telegram.srs"
            },
            {
                "tag": "site-x",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-x.srs"
            },
            {
                "tag": "site-facebook",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-facebook.srs"
            },
            {
                "tag": "site-bilibili",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-bilibili.srs"
            },
            {
                "tag": "site-twitch",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-twitch.srs"
            },
            {
                "tag": "site-tiktok",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-tiktok.srs"
            },
            {
                "tag": "site-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-netflix.srs"
            },
            {
                "tag": "site-apple",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-apple.srs"
            },
            {
                "tag": "site-microsoft",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-microsoft.srs"
            },
            {
                "tag": "site-proxy-dustinwin",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs"
            },
            {
                "tag": "site-direct-dustinwin",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cn.srs"
            },
            {
                "tag": "ip-telegram-dustinwin",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/telegramip.srs"
            },
            {
                "tag": "ip-netflix-dustinwin",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/netflixip.srs"
            },
            {
                "tag": "ip-cn-dustinwin",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cnip.srs"
            }
        ]
    }
}