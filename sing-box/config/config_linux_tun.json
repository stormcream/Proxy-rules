{
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "external_ui": "ui",
            "secret": "",
            "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
            "external_ui_download_detour": "AUTO",
            "default_mode": "rule"
        },
        "cache_file": {
            "enabled": true,
            "store_dns": true
        }
    },
    "services": [
        {
            "type": "api",
            "listen": "0.0.0.0",
            "listen_port": 9091,
            "secret": "",
            "access_control_allow_origin": [
                "http://sing-box-dashboard.sagernet.org",
                "https://sing-box-dashboard.sagernet.org"
            ],
            "access_control_allow_private_network": false
        }
    ],
    "log": {
        "level": "info",
        "timestamp": true
    },
    "ntp": {
        "enabled": true,
        "server": "ntp.tencent.com",
        "server_port": 123,
        "interval": "30m",
        "domain_resolver": "dns_direct"
    },
    "http_clients": [
        {
            "tag": "hc_direct",
            "detour": "DIRECT"
        },
        {
            "tag": "hc_proxy",
            "detour": "AUTO"
        }
    ],
    "dns": {
        "servers": [
            {
                "tag": "dns_proxy",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": {
                    "server": "hosts"
                },
                "detour": "DNS"
            },
            {
                "tag": "dns_direct",
                "type": "h3",
                "server": "dns.alidns.com",
                "domain_resolver": {
                    "server": "hosts"
                }
            },
            {
                "type": "hosts",
                "tag": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ],
                    "dns.alidns.com": [
                        "223.5.5.5",
                        "223.6.6.6"
                    ]
                }
            }
        ],
        "rules": [
            {
                "clash_mode": "direct",
                "server": "dns_direct"
            },
            {
                "clash_mode": "global",
                "server": "dns_proxy"
            },
            {
                "rule_set": "geosite-ads",
                "action": "reject"
            },
            {
                "rule_set": [
                    "emby-site",
                    "proxy-site",
                    "geosite-twitch",
                    "geosite-netflix",
                    "geosite-openai",
                    "geosite-youtube",
                    "geosite-google",
                    "geosite-github",
                    "geosite-telegram",
                    "geosite-twitter",
                    "geosite-facebook",
                    "geosite-tiktok",
                    "geosite-proxy"
                ],
                "server": "dns_proxy"
            },
            {
                "rule_set": [
                    "direct-site",
                    "geosite-bilibili",
                    "geosite-apple-cn",
                    "geosite-microsoft-cn",
                    "geosite-direct"
                ],
                "server": "dns_direct"
            }
        ],
        "final": "dns_proxy",
        "strategy": "ipv4_only"
    },
    "inbounds": [
        {
            "tag": "dns-in",
            "type": "direct",
            "listen": "::",
            "listen_port": 1053
        },
        {
            "tag": "http-in",
            "type": "http",
            "listen": "::",
            "listen_port": 8080
        },
        {
            "tag": "socks-in",
            "type": "socks",
            "listen": "::",
            "listen_port": 1080
        },
        {
            "tag": "redirect-in",
            "type": "redirect",
            "listen": "::",
            "listen_port": 7890
        },
        {
            "tag": "tproxy-in",
            "type": "tproxy",
            "listen": "::",
            "listen_port": 7891
        },
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.18.0.1/30"
            ],
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true,
            "stack": "mixed",
            "dns_mode": "hijack",
            "udp_timeout": "5m"
        }
    ],
    "outbounds": [
        {
            "tag": "PROXY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "AUTO",
            "type": "urltest",
            "outbounds": [],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "FINAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "GLOBAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "RELAY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "DNS",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "EMBY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "STREAMING",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "SOCIAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "AUTO-TEST",
            "type": "urltest",
            "outbounds": [
                "DIRECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "HK-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "TW-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "JP-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "SG-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "US-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "RD-SELECT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "HK-AUTO",
            "type": "urltest",
            "outbounds": [
                "HK-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "TW-AUTO",
            "type": "urltest",
            "outbounds": [
                "TW-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "JP-AUTO",
            "type": "urltest",
            "outbounds": [
                "JP-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "SG-AUTO",
            "type": "urltest",
            "outbounds": [
                "SG-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "US-AUTO",
            "type": "urltest",
            "outbounds": [
                "US-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "RD-AUTO",
            "type": "urltest",
            "outbounds": [
                "RD-SELECT"
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "60s",
            "tolerance": 100,
            "interrupt_exist_connections": false,
            "idle_timeout": "30m"
        },
        {
            "tag": "DIRECT",
            "type": "direct"
        }
    ],
    "route": {
        "final": "PROXY",
        "auto_detect_interface": true,
        "default_domain_resolver": "dns_direct",
        "default_http_client": "hc_proxy",
        "rules": [
            {
                "inbound": [
                    "http-in",
                    "socks-in",
                    "redirect-in",
                    "tproxy-in",
                    "tun-in"
                ],
                "action": "sniff",
                "timeout": "1s"
            },
            {
                "inbound": "dns-in",
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "DIRECT"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "network": "udp",
                        "port": 443
                    },
                    {
                        "protocol": "stun"
                    }
                ],
                "action": "reject",
                "method": "drop"
            },
            {
                "clash_mode": "direct",
                "outbound": "DIRECT"
            },
            {
                "clash_mode": "global",
                "outbound": "GLOBAL"
            },
            {
                "rule_set": "geosite-ads",
                "action": "reject"
            },
            {
                "rule_set": "proxy-site",
                "outbound": "PROXY"
            },
            {
                "rule_set": "emby-site",
                "outbound": "EMBY"
            },
            {
                "rule_set": "direct-site",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "geosite-openai",
                "outbound": "PROXY"
            },
            {
                "rule_set": "geosite-youtube",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "geosite-google",
                "outbound": "PROXY"
            },
            {
                "rule_set": "geosite-github",
                "outbound": "PROXY"
            },
            {
                "rule_set": "geosite-telegram",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "geosite-twitter",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "geosite-facebook",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "geosite-twitch",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "geosite-tiktok",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "geosite-netflix",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "geoip-google",
                "outbound": "PROXY"
            },
            {
                "rule_set": "geoip-telegram",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "geoip-twitter",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "geoip-facebook",
                "outbound": "SOCIAL"
            },
            {
                "rule_set": "geoip-netflix",
                "outbound": "STREAMING"
            },
            {
                "rule_set": "geosite-proxy",
                "outbound": "PROXY"
            },
            {
                "rule_set": "geosite-bilibili",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "geosite-apple-cn",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "geosite-microsoft-cn",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "geosite-direct",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "geoip-cn",
                "outbound": "DIRECT"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "geosite-ads",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblocksingbox.srs",
                "update_interval": "4h"
            },
            {
                "tag": "emby-site",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/emby.json",
                "update_interval": "4h"
            },
            {
                "tag": "proxy-site",
