{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-hosts",
                "type": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ],
                    "cloudflare-dns.com": [
                        "1.1.1.1",
                        "1.0.0.1"
                    ],
                    "dns.alidns.com": [
                        "223.5.5.5",
                        "223.6.6.6"
                    ],
                    "doh.pub": [
                        "120.53.53.53",
                        "1.12.12.12"
                    ]
                }
            },
            {
                "tag": "dns-proxy",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "dns-hosts",
                "detour": "DNSOUT"
            },
            {
                "tag": "dns-direct",
                "type": "https",
                "server": "dns.alidns.com",
                "domain_resolver": "dns-hosts"
            },
            {
                "tag": "dns-bootstrap",
                "type": "https",
                "server": "doh.pub",
                "domain_resolver": "dns-hosts"
            }
        ],
        "rules": [
            {
                "query_type": [
                    "SVCB",
                    "HTTPS",
                    "PTR"
                ],
                "action": "reject"
            },
            {
                "clash_mode": "direct",
                "server": "dns-direct"
            },
            {
                "clash_mode": "global",
                "server": "dns-proxy"
            },
            {
                "rule_set": [
                    "rule-blockHttpDNS",
                    "rule-ads"
                ],
                "action": "reject"
            },
            {
                "rule_set": [
                    "rule-emby-self",
                    "rule-proxy-self"
                ],
                "server": "dns-proxy"
            },
            {
                "rule_set": "rule-direct-self",
                "server": "dns-direct"
            },
            {
                "rule_set": [
                    "rule-ai",
                    "rule-youtube",
                    "rule-google",
                    "rule-github",
                    "rule-telegram",
                    "rule-x",
                    "rule-facebook",
                    "rule-twitch",
                    "rule-tiktok",
                    "rule-netflix"
                ],
                "server": "dns-proxy"
            },
            {
                "rule_set": [
                    "rule-bilibili",
                    "rule-apple",
                    "rule-microsoft"
                ],
                "server": "dns-direct"
            },
            {
                "rule_set": "rule-proxy",
                "server": "dns-proxy"
            },
            {
                "rule_set": "rule-direct",
                "server": "dns-direct"
            }
        ],
        "final": "dns-proxy",
        "cache_capacity": 4096,
        "strategy": "ipv4_only",
        "optimistic": {
            "enabled": true,
            "timeout": "12h"
        }
    },
    "ntp": {
        "enabled": true,
        "server": "time.apple.com",
        "server_port": 123,
        "interval": "30m",
        "domain_resolver": "dns-bootstrap"
    },
    "http_clients": [
        {
            "tag": "http-proxy",
            "version": 2,
            "stream_receive_window": 0,
            "connection_receive_window": 0,
            "detour": "AUTO"
        }
    ],
    "inbounds": [
        {
            "tag": "dns-in",
            "type": "direct",
            "listen": "::",
            "listen_port": 1053
        },
        {
            "tag": "http-in",
            "type": "http",
            "listen": "::",
            "listen_port": 8080
        },
        {
            "tag": "socks-in",
            "type": "socks",
            "listen": "::",
            "listen_port": 1080
        },
        {
            "tag": "redirect-in",
            "type": "redirect",
            "listen": "::",
            "listen_port": 7890
        },
        {
            "tag": "tproxy-in",
            "type": "tproxy",
            "listen": "::",
            "listen_port": 7891
        },
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "10.8.0.1/24",
                "fdfe:dcba:9876::1/126"
            ],
            "dns_mode": "hijack",
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true,
            "stack": "mixed"
        }
    ],
    "outbounds": [
        {
            "tag": "PROXY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "RELAY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "EMBY",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "AIGC",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "FINAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "GLOBAL",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "DNSOUT",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "AUTO",
            "type": "urltest",
            "outbounds": [],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "TESTING",
            "type": "urltest",
            "outbounds": [
                "DIRECT"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "S-HK",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-TW",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-JP",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-SG",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-US",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "S-RD",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "A-HK",
            "type": "urltest",
            "outbounds": [
                "S-HK"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "A-TW",
            "type": "urltest",
            "outbounds": [
                "S-TW"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "A-JP",
            "type": "urltest",
            "outbounds": [
                "S-JP"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "A-SG",
            "type": "urltest",
            "outbounds": [
                "S-SG"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "A-US",
            "type": "urltest",
            "outbounds": [
                "S-US"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "A-RD",
            "type": "urltest",
            "outbounds": [
                "S-RD"
            ],
            "url": "http://cp.cloudflare.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "DIRECT",
            "type": "direct"
        },
        {
            "tag": "BLOCK",
            "type": "block"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "ip_is_private": true,
                "outbound": "DIRECT"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "network": "udp",
                        "port": 443
                    },
                    {
                        "protocol": "stun"
                    }
                ],
                "action": "reject",
                "method": "drop"
            },
            {
                "clash_mode": "direct",
                "outbound": "DIRECT"
            },
            {
                "clash_mode": "global",
                "outbound": "GLOBAL"
            },
            {
                "rule_set": "rule-ads",
                "action": "reject"
            },
            {
                "rule_set": "rule-proxy-self",
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-emby-self",
                "outbound": "EMBY"
            },
            {
                "rule_set": "rule-direct-self",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "rule-ai",
                "outbound": "AIGC"
            },
            {
                "rule_set": "rule-youtube",
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-google",
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-github",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "rule-telegram",
                    "rule-ip-telegram"
                ],
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-x",
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-facebook",
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-twitch",
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-tiktok",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "rule-netflix",
                    "rule-ip-netflix"
                ],
                "outbound": "PROXY"
            },
            {
                "rule_set": "rule-bilibili",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "rule-apple",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "rule-microsoft",
                "outbound": "DIRECT"
            },
            {
                "rule_set": "rule-proxy",
                "outbound": "PROXY"
            },
            {
                "rule_set": [
                    "rule-direct",
                    "rule-ip-cn"
                ],
                "outbound": "DIRECT"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "rule-blockHttpDNS",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/senshinya/singbox_ruleset/refs/heads/main/rule/BlockHttpDNS/BlockHttpDNS.srs"
            },
            {
                "type": "remote",
                "tag": "rule-ads",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblocksingbox.srs"
            },
            {
                "tag": "rule-emby-self",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/emby.json"
            },
            {
                "tag": "rule-proxy-self",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/proxy.json"
            },
            {
                "tag": "rule-direct-self",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/refs/heads/main/sing-box/direct.json"
            },
            {
                "tag": "rule-ai",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/ai.srs"
            },
            {
                "tag": "rule-youtube",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-youtube.srs"
            },
            {
                "tag": "rule-google",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-google.srs"
            },
            {
                "tag": "rule-github",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-github.srs"
            },
            {
                "tag": "rule-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-telegram.srs"
            },
            {
                "tag": "rule-x",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-x.srs"
            },
            {
                "tag": "rule-facebook",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-facebook.srs"
            },
            {
                "tag": "rule-bilibili",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-bilibili.srs"
            },
            {
                "tag": "rule-twitch",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-twitch.srs"
            },
            {
                "tag": "rule-tiktok",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-tiktok.srs"
            },
            {
                "tag": "rule-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-netflix.srs"
            },
            {
                "tag": "rule-apple",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-apple.srs"
            },
            {
                "tag": "rule-microsoft",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-microsoft.srs"
            },
            {
                "tag": "rule-proxy",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs"
            },
            {
                "tag": "rule-direct",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cn.srs"
            },
            {
                "tag": "rule-ip-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/telegramip.srs"
            },
            {
                "tag": "rule-ip-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/netflixip.srs"
            },
            {
                "tag": "rule-ip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cnip.srs"
            }
        ],
        "final": "FINAL",
        "auto_detect_interface": true,
        "default_domain_resolver": {
            "server": "dns-bootstrap",
            "strategy": "prefer_ipv6"
        },
        "default_http_client": "http-proxy"
    },
    "services": [
        {
            "type": "api",
            "listen": "0.0.0.0",
            "listen_port": 9091,
            "secret": "",
            "access_control_allow_origin": [],
            "access_control_allow_private_network": true,
            "dashboard": {
                "enabled": true,
                "path": "/etc/sing-box/dashboard",
                "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "http-proxy"
            }
        }
    ],
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "default_mode": "rule"
        },
        "cache_file": {
            "enabled": true,
            "path": "/etc/sing-box/cache.db",
            "store_dns": true
        }
    }
}