{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-local",
                "type": "local"
            },
            {
                "tag": "dns-hosts",
                "type": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ],
                    "cloudflare-dns.com": [
                        "1.1.1.1",
                        "1.0.0.1"
                    ],
                    "dns.alidns.com": [
                        "223.5.5.5",
                        "223.6.6.6"
                    ],
                    "doh.pub": [
                        "120.53.53.53",
                        "1.12.12.12"
                    ],
                    "dns.quad9.net": [
                        "9.9.9.9",
                        "149.112.112.112"
                    ]
                }
            },
            {
                "tag": "dns-proxy",
                "type": "https",
                "server": "dns.quad9.net",
                "domain_resolver": "dns-hosts",
                "detour": "DNS"
            },
            {
                "tag": "dns-prefetch",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "dns-hosts",
                "detour": "DNS"
            },
            {
                "tag": "dns-direct",
                "type": "https",
                "server": "dns.alidns.com",
                "domain_resolver": "dns-hosts"
            },
            {
                "tag": "dns-bootstrap",
                "type": "https",
                "server": "doh.pub",
                "domain_resolver": "dns-hosts"
            }
        ],
        "rules": [
            {
                "rule_set": "rule-private",
                "action": "route",
                "server": "dns-local"
            },
            {
                "query_type": [
                    "SVCB",
                    "HTTPS"
                ],
                "action": "reject"
            },
            {
                "rule_set": "rule-block-private",
                "action": "reject"
            },
            {
                "rule_set": "rule-ads",
                "action": "reject"
            },
            {
                "clash_mode": "direct",
                "action": "route",
                "server": "dns-direct"
            },
            {
                "clash_mode": "global",
                "action": "route",
                "server": "dns-proxy"
            },
            {
                "rule_set": [
                    "rule-emby-private",
                    "rule-proxy-private"
                ],
                "action": "route",
                "server": "dns-proxy"
            },
            {
                "rule_set": "rule-direct-private",
                "action": "route",
                "server": "dns-direct"
            },
            {
                "rule_set": [
                    "rule-ai",
                    "rule-youtube",
                    "rule-google",
                    "rule-github",
                    "rule-telegram",
                    "rule-x",
                    "rule-facebook",
                    "rule-twitch",
                    "rule-tiktok",
                    "rule-netflix"
                ],
                "action": "route",
                "server": "dns-proxy"
            },
            {
                "rule_set": [
                    "rule-bilibili",
                    "rule-apple",
                    "rule-microsoft"
                ],
                "action": "route",
                "server": "dns-direct"
            },
            {
                "rule_set": "rule-proxy",
                "action": "route",
                "server": "dns-proxy"
            },
            {
                "rule_set": "rule-direct",
                "action": "route",
                "server": "dns-direct"
            },
            {
                "action": "evaluate",
                "tag": "prefetch",
                "server": "dns-prefetch",
                "client_subnet": "123.123.123.123/24"
            },
            {
                "match_response": "prefetch",
                "rule_set": "rule-ip-cn",
                "action": "route",
                "server": "dns-direct"
            },
            {
                "action": "route",
                "server": "dns-proxy"
            }
        ],
        "final": "dns-proxy",
        "cache_capacity": 8192,
        "strategy": "ipv4_only",
        "optimistic": {
            "enabled": true,
            "timeout": "1d"
        }
    },
    "http_clients": [
        {
            "tag": "http-proxy",
            "version": 2,
            "stream_receive_window": 0,
            "connection_receive_window": 0,
            "detour": "Auto"
        }
    ],
    "inbounds": [
        {
            "tag": "dns-in",
            "type": "direct",
            "listen": "::",
            "listen_port": 1053
        },
        {
            "tag": "http-in",
            "type": "http",
            "listen": "::",
            "listen_port": 8080
        },
        {
            "tag": "socks-in",
            "type": "socks",
            "listen": "::",
            "listen_port": 1080
        },
        {
            "tag": "redirect-in",
            "type": "redirect",
            "listen": "::",
            "listen_port": 7890
        },
        {
            "tag": "tproxy-in",
            "type": "tproxy",
            "listen": "::",
            "listen_port": 7891
        },
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "tag": "Proxies",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Relay",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Emby",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Github",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "X",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Facebook",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Twitch",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Tiktok",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Netflix",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Bilibili",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Youtube",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Telegram",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Google",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Microsoft",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "OpenAI",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Apple",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Final",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Global",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "DNS",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "SSH",
            "type": "selector",
            "outbounds": []
        },
        {
            "tag": "Auto",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "Testing",
            "type": "urltest",
            "outbounds": [
                "Direct"
            ],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "AUTO-HK",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "AUTO-TW",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "AUTO-JP",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "AUTO-SG",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "AUTO-US",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "AUTO-RD",
            "type": "urltest",
            "outbounds": [],
            "url": "http://captive.apple.com/generate_204",
            "interval": "3m",
            "tolerance": 100
        },
        {
            "tag": "Direct",
            "type": "direct"
        },
        {
            "tag": "Block",
            "type": "block"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "rule_set": "rule-private",
                "outbound": "Direct"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "network": "udp",
                        "port": 443
                    },
                    {
                        "protocol": "stun"
                    }
                ],
                "action": "reject",
                "method": "drop"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "port": 22
                    },
                    {
                        "rule_set": "rule-ip-cn",
                        "invert": true
                    }
                ],
                "outbound": "SSH"
            },
            {
                "rule_set": "rule-block-private",
                "action": "reject"
            },
            {
                "rule_set": "rule-ads",
                "action": "reject"
            },
            {
                "clash_mode": "direct",
                "outbound": "Direct"
            },
            {
                "clash_mode": "global",
                "outbound": "Global"
            },
            {
                "rule_set": "rule-proxy-private",
                "outbound": "Proxies"
            },
            {
                "rule_set": "rule-emby-private",
                "outbound": "Emby"
            },
            {
                "rule_set": "rule-direct-private",
                "outbound": "Direct"
            },
            {
                "rule_set": "rule-ai",
                "outbound": "OpenAI"
            },
            {
                "rule_set": "rule-youtube",
                "outbound": "Youtube"
            },
            {
                "rule_set": "rule-google",
                "outbound": "Google"
            },
            {
                "rule_set": "rule-github",
                "outbound": "Github"
            },
            {
                "rule_set": "rule-telegram",
                "outbound": "Telegram"
            },
            {
                "rule_set": "rule-x",
                "outbound": "X"
            },
            {
                "rule_set": "rule-facebook",
                "outbound": "Facebook"
            },
            {
                "rule_set": "rule-twitch",
                "outbound": "Twitch"
            },
            {
                "rule_set": "rule-tiktok",
                "outbound": "Tiktok"
            },
            {
                "rule_set": "rule-netflix",
                "outbound": "Netflix"
            },
            {
                "rule_set": "rule-bilibili",
                "outbound": "Bilibili"
            },
            {
                "rule_set": "rule-apple",
                "outbound": "Apple"
            },
            {
                "rule_set": "rule-microsoft",
                "outbound": "Microsoft"
            },
            {
                "rule_set": "rule-proxy",
                "outbound": "Proxies"
            },
            {
                "rule_set": "rule-direct",
                "outbound": "Direct"
            },
            {
                "rule_set": "rule-ip-telegram",
                "outbound": "Telegram"
            },
            {
                "rule_set": "rule-ip-netflix",
                "outbound": "Netflix"
            },
            {
                "rule_set": "rule-ip-cn",
                "outbound": "Direct"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "rule-ads",
                "format": "binary",
                "url": "https://gcore.jsdelivr.net/gh/217heidai/adblockfilters@main/rules/adblocksingbox.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-block-private",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/main/sing-box/block.json",
                "update_interval": "6h"
            },
            {
                "tag": "rule-emby-private",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/main/sing-box/emby.json",
                "update_interval": "6h"
            },
            {
                "tag": "rule-proxy-private",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/main/sing-box/proxy.json",
                "update_interval": "6h"
            },
            {
                "tag": "rule-direct-private",
                "type": "remote",
                "format": "source",
                "url": "https://raw.githubusercontent.com/stormcream/Proxy-rules/main/sing-box/direct.json",
                "update_interval": "6h"
            },
            {
                "tag": "rule-private",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/private.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-ai",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/ai.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-youtube",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/youtube.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-google",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-github",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/github.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/telegram.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-x",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/x.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-facebook",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/facebook.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-bilibili",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/bilibili.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-twitch",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/twitch.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-tiktok",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/tiktok.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/netflix.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-apple",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/apple-cn.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-microsoft",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/microsoft-cn.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-proxy",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-direct",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cn.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-ip-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-ip-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/netflix.srs",
                "update_interval": "6h"
            },
            {
                "tag": "rule-ip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cnip.srs",
                "update_interval": "6h"
            }
        ],
        "final": "Final",
        "auto_detect_interface": true,
        "default_domain_resolver": {
            "server": "dns-bootstrap",
            "strategy": "prefer_ipv6"
        },
        "default_http_client": "http-proxy"
    },
    "services": [
        {
            "type": "api",
            "listen": "0.0.0.0",
            "listen_port": 9091,
            "secret": "",
            "access_control_allow_origin": [],
            "access_control_allow_private_network": true,
            "dashboard": {
                "enabled": true,
                "path": "/etc/sing-box/dashboard",
                "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "http-proxy"
            }
        }
    ],
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "default_mode": "rule"
        },
        "cache_file": {
            "enabled": true,
            "path": "/etc/sing-box/cache.db",
            "store_dns": true
        }
    }
}